{
  "name": "datocms-plugin-places-autocomplete",
  "version": "1.0.0",
  "description": "A DatoCMS JSON field editor powered by Google Place Autocomplete.",
  "homepage": "https://github.com/rodrigobarona/datocms-plugin-places-autocomplete",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigobarona/datocms-plugin-places-autocomplete.git"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "datocms-plugin",
    "google-places",
    "address-autocomplete"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1",
  "datoCmsPlugin": {
    "title": "Google Places Autocomplete",
    "entryPoint": "dist/index.html",
    "permissions": []
  },
  "scripts": {
    "dev": "vite",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "check": "pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.3",
    "datocms-plugin-sdk": "2.5.0",
    "datocms-react-ui": "2.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/google.maps": "3.66.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "datocms-react-ui": {
      "react-intersection-observer": "11.0.1",
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
